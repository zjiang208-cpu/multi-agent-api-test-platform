AI_TEST_ENVIRONMENT=local
AI_TEST_DATA_DIR=.data
AI_TEST_ALLOW_REMOTE_TARGETS=false
AI_TEST_ALLOW_REMOTE_SOURCES=false
AI_TEST_LLM_ENABLED=false
AI_TEST_LLM_PROVIDER=openai_compatible
AI_TEST_LLM_MODEL=
AI_TEST_LLM_API_KEY_REF=
AI_TEST_LLM_BASE_URL=
AI_TEST_MAX_RESPONSE_BODY_LENGTH=12000

# The Python workflow reads this existing process variable only.
DEEPSEEK_API_KEY=

# Optional credentials referenced by a project's Auth Provider. Keep real
# values in the local environment and never commit them.
TEST_LOGIN_USER=
TEST_LOGIN_PASSWORD=
TEST_LOGIN_PHONE=
REDIS_PASSWORD=
API_TEST_AUTH_TOKEN=
